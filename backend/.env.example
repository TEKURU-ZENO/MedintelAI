# Copy to .env and set real values before any deployment.
# Generate a unique secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-unique-random-secret-before-deployment
CORS_ORIGINS=http://localhost:5173,app://medintel
MAX_UPLOAD_SIZE_MB=25
MAX_PDF_PAGES=100
# Use a properly provisioned database URL if enabling account/auth routes.
# DATABASE_URL=postgresql://user:password@localhost:5432/medintel
